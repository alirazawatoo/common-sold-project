# Copy to .env and fill in. Values below are placeholders for local development.
PORT=5000
API_VERSION=/api/v1/

DB_HOST=localhost
DB_PORT=3306
DB_NAME=stockroom
DB_USER=stockroom
DB_PASS=change-me
DB_DIALECT=mysql
DB_TIMEZONE=+00:00
DB_LOGGING=false
# Optional pool tuning (defaults: 10 / 0 / 30000 / 10000)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
